      "name": "Checkbox.Group",
      "summary": "由 `options` 生成的一组复选框；值是已勾选的选项的值组成的数组，按 `options` 的顺序。用于在少量、需要全部展示的选项中多选，如权限、通知渠道；选项多时用 `multiple` 的 Select。",
      "signature": null,
      "props": [
        {
          "name": "options",
          "type": "readonly (V | ChoiceOption<V>)[]",
          "description": "选项：直接是值（显示为文字），或选项对象。",
          "default": null,
          "required": true
        },
        {
          "name": "value",
          "type": "readonly V[]",
          "description": "已勾选的选项的值（受控）。",
          "default": null,
          "required": false
        },
        {
          "name": "defaultValue",
          "type": "readonly V[]",
          "description": "初始勾选的值（非受控）。",
          "default": null,
          "required": false
