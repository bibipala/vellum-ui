      "type": "boolean",
      "description": "内容贴边（表格、列表、树），不加内边距。",
      "default": null,
      "required": false
    },
    {
      "name": "padding",
      "type": "0 | 1 | 2 | 3 | 4 | 5 | 6 | 7 | 8",
