{
  "name": "IconButton",
  "entry": "vellum-ui",
  "usage": "工具栏与列表行里的次要操作（刷新、更多、下载、关闭）；强调样式用于发送等主操作",
  "signature": null,
  "props": [
    {
      "name": "icon",
      "type": "IconName | IconComponent",
      "description": "图标：图标名，或 Lucide 的 `Plus` 这样的图标组件。",
      "default": null,
      "required": true
    },
    {
      "name": "label",
      "type": "string",
      "description": "文字说明：作为提示与读屏名称（必填，图标按钮必须可理解）。",
      "default": null,
      "required": true
    },
    {
      "name": "variant",
      "type": "'ghost' | 'soft' | 'accent'",
      "description": "`accent`：强调色实心（如发送）；`ghost`：透明底（默认）；`soft`：中性填充底。",
      "default": null,
      "required": false
    },
    {
      "name": "size",
      "type": "'sm' | 'md' | 'lg'",
      "description": "尺寸：sm 用于列表行内，md 用于工具栏，lg 用于输入框旁的主操作（如发送）。",
      "default": null,
      "required": false
    },
    {
      "name": "tooltip",
      "type": "boolean",
      "description": "是否显示悬停提示，默认显示。",
      "default": null,
      "required": false
    },
    {
      "name": "active",
      "type": "boolean",
      "description": "按下态（切换按钮）。",
      "default": null,
      "required": false
    },
    {
      "name": "disabledReason",
      "type": "string",
      "description": "禁用原因：`disabled` 时悬停或键盘聚焦显示「说明：原因」，如「没有下载权限」。提供后按钮仍可用 Tab 聚焦（`aria-disabled`），读屏通过 `aria-describedby` 读出原因，点击与回车不生效；即使 `tooltip={false}` 也会显示原因。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
