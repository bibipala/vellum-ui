{
  "name": "PromptSuggestions",
  "entry": "vellum-ui/ai",
  "usage": "空对话的开场建议、回复之后的追问建议",
  "signature": null,
  "props": [
    {
      "name": "items",
      "type": "readonly PromptSuggestion[]",
      "description": "建议。",
      "default": null,
      "required": true
    },
    {
      "name": "onSelect",
      "type": "(item: PromptSuggestion) => void",
      "description": "用点击、`Enter` 或空格选择一条建议时调用。",
      "default": null,
      "required": false
    },
    {
      "name": "layout",
      "type": "'wrap' | 'vertical'",
      "description": "`wrap` 横向排列、放不下时换行；`vertical` 纵向排成一列、占满宽度。",
      "default": "'wrap'",
      "required": false
    },
    {
      "name": "aria-label",
      "type": "string",
      "description": "列表的读屏名称，默认「建议」。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": true,
  "native": null,
  "members": [],
