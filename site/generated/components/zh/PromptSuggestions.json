        {
          "name": "description",
          "type": "string",
          "description": "标签下方的说明。",
          "default": null,
          "required": false
        },
        {
          "name": "icon",
          "type": "IconName | IconComponent",
          "description": "文字前的图标：图标名，或 Lucide 的 `Sparkles` 这样的图标组件。",
          "default": null,
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "禁用这条建议。",
          "default": null,
          "required": false
        },
        {
          "name": "disabledReason",
          "type": "string",
          "description": "禁用原因：`disabled` 时悬停或键盘聚焦显示；这条建议仍可聚焦。",
          "default": null,
          "required": false
