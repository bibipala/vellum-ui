    {
      "name": "Radio.Group",
      "summary": "一组互斥的选项；值是选中的选项的值。选项用 `options` 给出，或以 Radio、Radio.Button 作为子元素；\n`variant=\"button\"` 把 `options` 显示为按钮。",
      "signature": null,
      "props": [
        {
          "name": "options",
          "type": "readonly (V | ChoiceOption<V>)[]",
          "description": "选项：直接是值（显示为文字），或选项对象。也可以不用 `options`，而以 Radio 或 Radio.Button 作为子元素。",
          "default": null,
          "required": false
        },
        {
          "name": "value",
          "type": "V",
          "description": "选中的选项的值（受控）。",
          "default": null,
          "required": false
        },
        {
          "name": "defaultValue",
          "type": "V",
          "description": "初始选中的值（非受控）。",
          "default": null,
          "required": false
        },
        {
          "name": "onChange",
          "type": "(value: V) => void",
          "description": "选中的选项变化时调用，参数是新选中的选项的值。",
          "default": null,
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "禁用全部选项。",
          "default": null,
          "required": false
        },
        {
          "name": "variant",
          "type": "'default' | 'button'",
          "description": "以按钮的样式显示 `options`（与 Radio.Button 相同）。切换视图优先用 Segmented。",
          "default": "'default'",
          "required": false
        },
        {
          "name": "size",
          "type": "'sm' | 'md' | 'lg'",
