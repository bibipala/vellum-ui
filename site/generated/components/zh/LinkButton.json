  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "强调色文字、无底色、无下划线，字号跟随所在位置。表格行内的编辑、归档，卡片上的「查看」都用它。",
      "section": "基本用法"
    },
    {
      "name": "InlineName",
      "title": "可点击的名称",
      "description": "列表中打开详情的名称：放在正文中也不会显得突兀，点击区域比文字四周各大 4px。",
      "section": "变体"
    },
    {
      "name": "Danger",
      "title": "危险操作",
      "description": "移除、撤销授权等行内的危险操作用 `tone=\"danger\"`；不可恢复的操作仍需确认（Popconfirm 或 useConfirmDanger）。",
      "section": "变体"
    },
    {
      "name": "Disabled",
      "title": "禁用与禁用原因",
      "description": "因权限或条件不满足而禁用时，用 disabledReason 说明原因：悬停或键盘聚焦时显示，读屏也能读到。",
      "section": "状态"
    }
  ],
  "demoFrame": false
