{
  "name": "LinkButton",
  "entry": "vellum-ui",
  "usage": "表格行内的编辑、归档、移除；列表中可点击的名称；卡片上的「查看」「置顶」",
  "signature": null,
  "props": [
    {
      "name": "children",
      "type": "ReactNode",
      "description": "按钮文字。",
      "default": null,
      "required": true
    },
    {
      "name": "tone",
      "type": "'accent' | 'danger'",
      "description": "色调：`accent` 强调色（默认）；`danger` 用于移除、撤销授权等危险的行内操作。",
      "default": "'accent'",
      "required": false
    },
    {
      "name": "icon",
      "type": "IconName | IconComponent",
      "description": "文字前的图标：图标名，或 Lucide 的 `Plus` 这样的图标组件。",
      "default": null,
      "required": false
    },
    {
      "name": "disabledReason",
      "type": "string",
      "description": "禁用原因：`disabled` 时悬停或键盘聚焦显示的说明（与 Button 相同）。提供后按钮仍可用 Tab 聚焦（`aria-disabled`），读屏通过 `aria-describedby` 读出原因，点击与回车不生效。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
  "native": "ButtonHTMLAttributes",
  "members": [],
