{
  "name": "Dropdown",
  "entry": "vellum-ui",
  "usage": "行内「更多」操作、账户菜单、主题切换、新建的多个选项",
  "signature": null,
  "props": [
    {
      "name": "menu",
      "type": "DropdownMenu",
      "description": "菜单：`items`、`onClick` 与 `selectedKeys`。",
      "default": null,
      "required": true
    },
    {
      "name": "trigger",
      "type": "readonly ('click' | 'hover' | 'contextMenu')[]",
      "description": "打开菜单的方式：`click` 点击、`hover` 悬停、`contextMenu` 右键。",
      "default": "['hover']",
      "required": false
    },
    {
      "name": "placement",
      "type": "'bottomLeft' | 'bottom' | 'bottomRight' | 'topLeft' | 'top' | 'topRight'",
      "description": "菜单相对触发元素的位置。",
      "default": "'bottomLeft'",
      "required": false
    },
    {
      "name": "open",
      "type": "boolean",
      "description": "菜单是否打开（受控）。",
      "default": null,
      "required": false
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "description": "菜单打开或关闭时调用。",
      "default": null,
      "required": false
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "触发元素：一个能接收事件与 ref 的元素，通常是 Button 或 IconButton。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
  "native": null,
