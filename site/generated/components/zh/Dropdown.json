        {
          "name": "items",
          "type": "readonly DropdownMenuItem[]",
          "description": "菜单项：操作与分隔线（`{ type: 'divider' }`）。",
          "default": null,
          "required": true
        },
        {
          "name": "onClick",
          "type": "(info: { readonly key: string }) => void",
          "description": "选择菜单项时调用，参数中是该项的 key；之后菜单关闭。",
          "default": null,
          "required": false
        },
        {
          "name": "selectedKeys",
          "type": "readonly string[]",
          "description": "显示为选中的菜单项的 key，如设置菜单的当前选项。",
          "default": null,
          "required": false
        }
