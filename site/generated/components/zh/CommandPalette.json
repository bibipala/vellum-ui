{
  "name": "CommandPalette",
  "entry": "vellum-ui",
  "usage": "全局搜索与跳转（`Mod+K`）、按名称执行操作、查找人员与文件",
  "signature": null,
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "description": "是否打开。",
      "default": null,
      "required": true
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "description": "面板要求打开或关闭时调用（`Esc`、点击外部、执行条目后）。",
      "default": null,
      "required": true
    },
    {
      "name": "items",
      "type": "readonly CommandPaletteItem[]",
      "description": "条目，输入时在本地匹配（见 matchCommands）。",
      "default": null,
      "required": true
    },
    {
      "name": "onSearch",
      "type": "(query: string, signal: AbortSignal) => Promise<readonly CommandPaletteItem[]>",
      "description": "按查询搜索更多条目，如服务器上的人员、文件。停止输入 150ms 后调用；查询变化或面板关闭时 signal 被取消。结果原样排在本地匹配的结果之后（不再匹配一次）。",
      "default": null,
      "required": false
    },
    {
      "name": "placeholder",
      "type": "string",
      "description": "搜索框的占位文字，默认「搜索或执行命令」（随 `locale`）。",
      "default": null,
      "required": false
    },
    {
      "name": "emptyText",
      "type": "string",
      "description": "没有匹配结果时的文字，默认「没有匹配的结果」（随 `locale`）。",
      "default": null,
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "description": "对话框与搜索框的读屏名称，默认「命令面板」（随 `locale`）。",
      "default": null,
      "required": false
    },
    {
      "name": "limit",
      "type": "number",
      "description": "最多显示的结果数；超过时列表下方提示还有多少条。",
      "default": "50",
      "required": false
    }
  ],
  "modes": [],
  "base": true,
  "native": null,
  "members": [],
  "types": [
    {
      "name": "CommandPaletteItem",
      "entry": "vellum-ui",
      "summary": "CommandPalette 的一个条目：要跳转的页面或要执行的操作。",
      "definition": null,
      "fields": [
        {
          "name": "id",
          "type": "string",
          "description": "唯一编号。",
          "default": null,
          "required": true
        },
        {
          "name": "title",
          "type": "string",
          "description": "标题，显示并优先匹配。",
          "default": null,
          "required": true
        },
        {
          "name": "group",
          "type": "string",
          "description": "显示在行末的分组，如「页面」「操作」；同一分组的条目排在一起。",
          "default": null,
          "required": false
        },
        {
          "name": "icon",
          "type": "IconName | IconComponent",
          "description": "行首的图标：图标名，或 Lucide 的 `Settings` 这样的图标组件。",
          "default": null,
          "required": false
        },
        {
          "name": "keywords",
          "type": "readonly string[]",
          "description": "也能命中的其他词，如同义词、英文名。",
          "default": null,
          "required": false
        },
        {
          "name": "shortcut",
          "type": "string | readonly string[]",
          "description": "用 Kbd 显示的快捷键提示，如 `'mod+n'`。",
          "default": null,
          "required": false
        },
        {
          "name": "onSelect",
          "type": "() => void",
          "description": "执行条目；面板会先关闭。",
          "default": null,
          "required": false
        }
      ],
      "values": []
    },
