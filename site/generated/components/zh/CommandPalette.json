    {
      "name": "IconComponent",
      "entry": "vellum-ui",
      "summary": "图标组件，如 Lucide 的 `Plus`（`import { Plus } from 'lucide-react'`），可以用在所有接受图标名的地方：\n`<Button icon={Plus}>`、`<Icon icon={Plus} />`、菜单项等。名称（`icon=\"plus\"`）写起来方便，也能写在菜单配置等数据里，但只包括登记过的图标（`iconNames`）；图标组件可以是任何 Lucide 图标，也可以是自己画的 SVG。两者按同样的尺寸、线宽与\n`tone` 绘制。",
      "definition": "type IconComponent = ComponentType<IconComponentProps>",
      "fields": [],
      "values": []
    },
    {
      "name": "IconComponentProps",
      "entry": "vellum-ui",
      "summary": "Icon 传给图标组件的属性。Lucide 图标（`import { Plus } from 'lucide-react'`）都接受这些属性；其他图标库的组件、或者自己画的 SVG 组件，只要接受这些属性（或把它们传给自己的 `<svg>`）也可以使用。",
      "definition": null,
      "fields": [
        {
          "name": "size",
          "type": "number",
          "description": "宽高（像素）。",
          "default": null,
          "required": false
        },
        {
          "name": "strokeWidth",
          "type": "number",
          "description": "线宽，单位是 24 × 24 视图框中的单位，已按 `size` 换算：无论图标多大，屏幕上的线宽默认都是 1.75 像素。",
          "default": null,
          "required": false
        },
        {
          "name": "color",
          "type": "string",
          "description": "描线颜色：`currentColor`（文字颜色）或语义色变量，如 `var(--vl-color-danger)`。",
          "default": null,
          "required": false
        },
        {
          "name": "aria-hidden",
          "type": "boolean",
          "description": "纯装饰的图标为 `true`（对读屏隐藏）。",
          "default": null,
          "required": false
        },
        {
          "name": "aria-label",
          "type": "string",
          "description": "有含义的图标的读屏名称。",
          "default": null,
          "required": false
        },
        {
          "name": "role",
          "type": "string",
          "description": "有含义的图标为 `img`。",
          "default": null,
          "required": false
        }
      ],
      "values": []
    }
  ],
  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "用按钮或 `Mod+K`（用 useHotkeys 注册）打开，输入以筛选，`↑` / `↓` 与 `Enter` 执行。模糊匹配：输入 “nwp” 能找到\n“New project”。HotkeysProvider 让示例的 `Mod+K` 不与展示它的页面自己的 `Mod+K` 冲突。",
      "section": "基本用法"
    },
    {
      "name": "ManyResults",
      "title": "大量结果",
      "description": "最多显示 `limit` 条（默认 50），列表下方提示还有多少条。",
      "section": "状态"
    },
    {
      "name": "AsyncSearch",
      "title": "搜索服务器",
      "description": "`onSearch` 把服务器上的结果加在本地匹配之后。停止输入后调用，查询变化时 signal 被取消；搜索较慢时才显示「正在搜索」。",
      "section": "进阶用法"
    }
  ],
  "demoFrame": false
