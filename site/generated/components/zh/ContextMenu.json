  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "在行上右键，或聚焦后按 `Shift+F10`（或菜单键）。行可以聚焦，键盘用户同样能打开菜单。",
      "section": "基本用法"
    },
    {
      "name": "DisabledItems",
      "title": "禁用项与分隔线",
