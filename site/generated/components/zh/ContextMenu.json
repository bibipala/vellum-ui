{
  "name": "ContextMenu",
  "entry": "vellum-ui",
  "usage": "列表行、文件、图片、消息上的操作，符合桌面应用习惯",
  "signature": null,
  "props": [
    {
      "name": "items",
      "type": "readonly ContextMenuItem[]",
      "description": "菜单项：操作（`key`、`label`、`icon`、`danger`、`disabled`、`shortcut`、`onClick`）与分隔线（`{ type: 'divider' }`）。没有菜单项时显示浏览器自己的菜单。",
      "default": null,
      "required": true
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "带菜单的内容：列表行、文件、图片、消息。键盘用户要能打开菜单，内容（或其中的元素）必须可以聚焦。",
      "default": null,
      "required": true
    },
    {
      "name": "onSelect",
      "type": "(key: string) => void",
      "description": "选择菜单项后调用（在该项的 `onClick` 之后），参数是菜单项的 key。",
      "default": null,
      "required": false
    },
    {
      "name": "onOpenChange",
      "type": "(open: boolean) => void",
      "description": "菜单打开或关闭时调用。",
      "default": null,
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "禁用：右键时显示浏览器自己的菜单。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": true,
  "native": null,
  "members": [],
