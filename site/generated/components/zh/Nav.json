{
  "name": "Nav",
  "entry": "vellum-ui",
  "usage": "应用侧栏中的主导航；设置区域中的分区导航",
  "signature": null,
  "props": [
    {
      "name": "items",
      "type": "readonly (NavItem | NavGroup)[]",
      "description": "项与分组，按顺序排列。不属于分组的项通常放在最前面（首页、收件箱）。",
      "default": null,
      "required": true
    },
    {
      "name": "value",
      "type": "string | null",
      "description": "当前页面的 key：该项显示为选中，并带 `aria-current=\"page\"`。没有当前项时为 `null`。",
      "default": null,
      "required": false
    },
    {
      "name": "onSelect",
      "type": "(key: string) => void",
      "description": "选择一项时以 key 调用。对带 `href` 的项，普通点击调用它而不跳转（客户端路由）；按住修饰键或用中键点击时照常打开链接。不传 `onSelect` 时，链接由浏览器打开。",
      "default": null,
      "required": false
    },
    {
      "name": "collapsed",
      "type": "boolean",
      "description": "只显示图标：文字在右侧的提示中显示，仍是读屏名称；分组标题隐藏。在 AppShell 的侧栏中不传时跟随侧栏。",
      "default": null,
      "required": false
    },
    {
      "name": "aria-label",
      "type": "string",
      "description": "导航区域的读屏名称；不传时为「主导航」。同一页面有多个 Nav 时各起一个名称。",
      "default": null,
      "required": false
    },
    {
      "name": "testId",
      "type": "string",
      "description": "测试定位，输出为 `data-testid`。",
      "default": null,
      "required": false
    },
    {
      "name": "id",
      "type": "string",
      "description": "`nav` 元素的 `id`。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
  "native": null,
  "members": [],
  "types": [
    {
      "name": "NavItem",
      "entry": "vellum-ui",
      "summary": "Nav 的一项：应用中的一个页面。",
      "definition": null,
      "fields": [
        {
          "name": "key",
          "type": "string",
          "description": "唯一标识，传给 `onSelect`，并与 `value` 比较。",
          "default": null,
          "required": true
        },
        {
          "name": "label",
          "type": "string",
          "description": "文字；Nav 收起时也是提示与读屏名称。",
          "default": null,
          "required": true
        },
        {
          "name": "icon",
          "type": "IconName | IconComponent",
          "description": "图标：图标名，或 Lucide 的 `House` 这样的图标组件。要么每一项都有图标，要么都没有：收起时没有图标的项显示一个圆点。",
          "default": null,
          "required": false
        },
        {
          "name": "count",
          "type": "number",
          "description": "末尾的计数（CountBadge）；为 0 或不传时不显示。",
          "default": null,
          "required": false
        },
        {
          "name": "countTone",
          "type": "'neutral' | 'accent'",
          "description": "计数的色调：未读与待办用 `accent`，普通计数用 `neutral`。",
          "default": "'neutral'",
          "required": false
        },
        {
          "name": "href",
          "type": "string",
          "description": "页面地址：该项是真正的链接（`<a href>`），可以在新标签页中打开。不传时该项是调用 `onSelect` 的按钮。",
          "default": null,
          "required": false
        },
        {
          "name": "disabled",
          "type": "boolean",
          "description": "禁用：淡化显示，不能聚焦与选择。",
          "default": null,
          "required": false
        }
      ],
      "values": []
    },
    {
      "name": "NavGroup",
      "entry": "vellum-ui",
      "summary": "Nav 中带标题的一组项。",
      "definition": null,
      "fields": [
        {
          "name": "type",
          "type": "'group'",
          "description": "表示这一项是分组。",
          "default": null,
          "required": true
        },
        {
          "name": "key",
          "type": "string",
          "description": "分组的唯一标识；不传时用标题。",
          "default": null,
          "required": false
        },
        {
          "name": "label",
          "type": "string",
          "description": "分组标题；Nav 收起时隐藏（读屏仍会读出）。",
          "default": null,
          "required": true
        },
        {
          "name": "items",
          "type": "readonly NavItem[]",
          "description": "分组中的项（分组不能嵌套）。",
          "default": null,
          "required": true
        }
      ],
      "values": []
    },
