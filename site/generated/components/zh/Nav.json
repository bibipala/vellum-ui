  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "带图标与计数的项，然后是带标题的分组。`value` 是当前页面的 key，`onSelect` 收到所选项的 key。在应用中，Nav 放在 AppShell 的 `sidebar` 中。",
      "section": "基本用法"
    },
    {
      "name": "Links",
      "title": "链接",
      "description": "带 `href` 的项是真正的链接，可以在新标签页中打开。传入 `onSelect` 时，普通点击调用它而不跳转：在这里调用路由的跳转。",
      "section": "变体"
    },
    {
      "name": "Collapsed",
      "title": "收起",
      "description": "`collapsed` 只显示图标；文字在提示中出现，仍是读屏名称。在 AppShell 中 Nav 跟随侧栏，不需要自己设置 `collapsed`。",
      "section": "变体"
    },
    {
      "name": "Disabled",
      "title": "禁用的项",
      "description": "禁用的项淡化显示，`Tab` 与方向键都会跳过它。",
      "section": "状态"
    }
  ],
  "demoFrame": false
