{
  "name": "Avatar",
  "entry": "vellum-ui",
  "usage": "会话、团队、项目的头像；列表行的 leading；账户菜单；带在线状态的成员头像",
  "signature": null,
  "props": [
    {
      "name": "name",
      "type": "string",
      "description": "姓名或名称：取第一个字符显示，并按整个名称稳定地决定色调（同一名称在各处颜色相同）。",
      "default": null,
      "required": true
    },
    {
      "name": "size",
      "type": "number",
      "description": "像素尺寸：常用 20（表格、标签）、28（侧栏）、32（列表）。",
      "default": "32",
      "required": false
    },
    {
      "name": "ring",
      "type": "boolean",
      "description": "强调色外环：团队、当前用户等需要突出的头像。",
      "default": null,
      "required": false
    },
    {
      "name": "icon",
      "type": "IconName | IconComponent",
      "description": "以图标代替文字（如系统通知），底色为中性填充，不取色调：图标名，或 Lucide 的 `Bell` 这样的图标组件。",
      "default": null,
      "required": false
    },
    {
      "name": "status",
      "type": "StatusDotProps['tone']",
      "description": "右下角的状态角标（StatusDot 的色调），如在线状态；不传则不显示。",
      "default": null,
      "required": false
    },
    {
      "name": "statusLabel",
      "type": "string",
      "description": "状态角标的读屏名称，如「在线」；不传时用色调的默认名称。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
  "native": null,
  "members": [],
