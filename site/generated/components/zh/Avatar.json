  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "取名称首字，按名称稳定地取五种色调之一（同一名称在各处颜色相同）；尺寸常用 20、28、32。",
      "section": "基本用法"
    },
    {
      "name": "RingAndIcon",
      "title": "外环与图标",
      "description": "`ring` 加强调色外环，用于团队、当前用户等需要突出的头像；`icon` 以图标代替文字（如系统通知），底色为中性填充。",
      "section": "变体"
    },
    {
      "name": "WithStatus",
      "title": "状态角标",
      "description": "`status` 取 StatusDot 的色调，显示在右下角；`statusLabel` 是读屏名称。",
      "section": "变体"
    }
