    {
      "name": "IconComponent",
      "entry": "vellum-ui",
      "summary": "图标组件，如 Lucide 的 `Plus`（`import { Plus } from 'lucide-react'`），可以用在所有接受图标名的地方：\n`<Button icon={Plus}>`、`<Icon icon={Plus} />`、菜单项等。名称（`icon=\"plus\"`）写起来方便，也能写在菜单配置等数据里，但只包括登记过的图标（`iconNames`）；图标组件可以是任何 Lucide 图标，也可以是自己画的 SVG。两者按同样的尺寸、线宽与\n`tone` 绘制。",
      "definition": "type IconComponent = ComponentType<IconComponentProps>",
      "fields": [],
      "values": []
    },
    {
      "name": "StatusDotProps",
      "entry": "vellum-ui",
      "summary": "StatusDot 属性。",
      "definition": null,
      "fields": [
        {
          "name": "tone",
          "type": "'success' | 'warning' | 'danger' | 'neutral' | 'accent'",
          "description": "色调：success 正常、warning 注意、danger 异常、neutral 未激活、accent 提醒。业务含义（在线、运行中、已停用……）由调用方映射到色调，并通过 `aria-label` 说明。",
          "default": null,
          "required": true
        }
      ],
      "values": []
    },
    {
      "name": "IconComponentProps",
      "entry": "vellum-ui",
      "summary": "Icon 传给图标组件的属性。Lucide 图标（`import { Plus } from 'lucide-react'`）都接受这些属性；其他图标库的组件、或者自己画的 SVG 组件，只要接受这些属性（或把它们传给自己的 `<svg>`）也可以使用。",
      "definition": null,
      "fields": [
        {
          "name": "size",
          "type": "number",
          "description": "宽高（像素）。",
          "default": null,
          "required": false
        },
        {
          "name": "strokeWidth",
          "type": "number",
          "description": "线宽，单位是 24 × 24 视图框中的单位，已按 `size` 换算：无论图标多大，屏幕上的线宽默认都是 1.75 像素。",
          "default": null,
          "required": false
        },
        {
          "name": "color",
          "type": "string",
          "description": "描线颜色：`currentColor`（文字颜色）或语义色变量，如 `var(--vl-color-danger)`。",
          "default": null,
          "required": false
        },
        {
          "name": "aria-hidden",
          "type": "boolean",
          "description": "纯装饰的图标为 `true`（对读屏隐藏）。",
          "default": null,
          "required": false
        },
        {
          "name": "aria-label",
          "type": "string",
          "description": "有含义的图标的读屏名称。",
          "default": null,
          "required": false
        },
        {
          "name": "role",
          "type": "string",
          "description": "有含义的图标为 `img`。",
          "default": null,
          "required": false
        }
      ],
      "values": []
    },
    {
      "name": "BaseProps",
      "entry": "vellum-ui",
      "summary": "所有布局原语（以及部分其他组件）共有的可访问性与测试属性：`testId`、`aria-label`、`role`、`id`，输出在根元素上。",
      "definition": null,
      "fields": [],
      "values": []
    }
