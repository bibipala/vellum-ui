{
  "name": "Icon",
  "entry": "vellum-ui",
  "usage": "按钮、列表行、菜单、空状态中的图标；菜单配置的 `icon` 字段用同一套名称或图标组件",
  "signature": null,
  "props": [
    {
      "name": "name",
      "type": "IconName",
      "description": "图标名称，见 `iconNames`（只能使用登记过的图标）。`name` 与 `icon` 给一个；都不给时留出同样大小的空位。",
      "default": null,
      "required": false
    },
    {
      "name": "icon",
      "type": "IconComponent",
      "description": "用图标组件代替名称，如 Lucide 的 `Plus`；同时给了 `name` 时以它为准。任何 Lucide 图标都可以，不限于登记过的。",
      "default": null,
      "required": false
    },
    {
      "name": "size",
      "type": "number",
      "description": "像素尺寸，默认 16。",
      "default": null,
      "required": false
    },
    {
      "name": "strokeWidth",
      "type": "number",
      "description": "线宽，默认 1.75（细而清晰）。",
      "default": null,
      "required": false
    },
    {
      "name": "tone",
      "type": "'inherit' | 'secondary' | 'tertiary' | 'accent' | 'danger' | 'success' | 'warning'",
      "description": "颜色：inherit 跟随文字颜色（默认）；其余为语义色。悬停、选中等状态色由外层元素控制。",
      "default": "'inherit'",
      "required": false
    },
    {
      "name": "label",
      "type": "string",
      "description": "有含义的图标需要文字说明；纯装饰图标省略（对读屏隐藏）。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
