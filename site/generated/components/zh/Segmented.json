    {
      "name": "options",
      "type": "readonly (V | SegmentedOption<V>)[]",
      "description": "选项：直接是值（显示为文字），或选项对象。",
      "default": null,
      "required": true
    },
    {
      "name": "value",
      "type": "V",
      "description": "选中的选项的值（受控）。",
      "default": null,
      "required": false
