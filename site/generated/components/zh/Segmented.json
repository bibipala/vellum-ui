      "description": "初始选中的值（非受控）。",
      "default": null,
      "required": false
    },
    {
      "name": "onChange",
      "type": "(value: V) => void",
      "description": "选中的选项变化时调用，参数是新选中的选项的值。",
      "default": null,
      "required": false
    },
    {
      "name": "disabled",
      "type": "boolean",
      "description": "禁用全部选项。",
      "default": null,
      "required": false
