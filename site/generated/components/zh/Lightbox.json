{
  "name": "Lightbox",
  "entry": "vellum-ui",
  "usage": "图片预览、选图时放大查看",
  "signature": null,
  "props": [
    {
      "name": "open",
      "type": "boolean",
      "description": "是否打开。",
      "default": null,
      "required": true
    },
    {
      "name": "items",
      "type": "readonly LightboxItem[]",
      "description": "可切换的图片列表。",
      "default": null,
      "required": true
    },
    {
      "name": "index",
      "type": "number",
      "description": "当前显示的图片序号（受控）。",
      "default": null,
      "required": true
    },
    {
      "name": "onIndexChange",
      "type": "(index: number) => void",
      "description": "切换图片时调用。",
      "default": null,
      "required": false
    },
    {
      "name": "onClose",
      "type": "() => void",
      "description": "关闭时调用（`Esc`、关闭按钮、点击图片以外的地方、把图片拖走）。",
      "default": null,
      "required": true
    },
    {
      "name": "stage",
      "type": "'mid' | 'dark' | 'black'",
      "description": "指定背景档位；省略时使用 ThemeProvider 中的看图背景档位，并可在工具栏切换。",
      "default": null,
      "required": false
    }
  ],
  "modes": [],
  "base": false,
  "native": null,
  "members": [],
  "types": [
    {
      "name": "LightboxItem",
      "entry": "vellum-ui",
      "summary": "Lightbox 中的一张图片。",
      "definition": null,
      "fields": [
        {
          "name": "id",
          "type": "string",
          "description": "唯一标识；切换图片时据此替换图片元素，下一张加载时不会还显示上一张。",
          "default": null,
          "required": true
        },
        {
          "name": "src",
          "type": "string",
          "description": "大图的地址。",
          "default": null,
          "required": true
        },
        {
          "name": "alt",
          "type": "string",
          "description": "替代文字，供读屏读出，图片加载失败时由浏览器显示。",
          "default": null,
          "required": false
        }
      ],
      "values": []
    }
  ],
  "examples": [
    {
      "name": "Basic",
      "title": "基本用法",
      "description": "受控打开与切换；看图背景默认为中性灰，不随主题变化。",
      "section": "基本用法"
    }
  ],
  "demoFrame": false
}
