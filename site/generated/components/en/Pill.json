    {
      "name": "IconComponent",
      "entry": "vellum-ui",
      "summary": "An icon component, such as Lucide's `Plus` (`import { Plus } from 'lucide-react'`), accepted wherever an icon name\nis: `<Button icon={Plus}>`, `<Icon icon={Plus} />`, menu items and so on. Names (`icon=\"plus\"`) are convenient\nand work in data such as menu configurations, but cover only the registered icons (`iconNames`); a component can\nbe any Lucide icon, or an SVG of your own. Both are drawn with the same size, stroke width and `tone`.",
      "definition": "type IconComponent = ComponentType<IconComponentProps>",
      "fields": [],
      "values": []
    },
    {
      "name": "IconComponentProps",
      "entry": "vellum-ui",
      "summary": "Props that Icon passes to an icon component. Lucide icons (`import { Plus } from 'lucide-react'`) accept them; a\ncomponent of another icon set, or an SVG of your own, works too if it accepts them, or passes them on to its\n`<svg>`.",
      "definition": null,
      "fields": [
        {
          "name": "size",
          "type": "number",
          "description": "Width and height in pixels.",
          "default": null,
          "required": false
        },
        {
          "name": "strokeWidth",
          "type": "number",
          "description": "Stroke width in the units of a 24 × 24 view box, already scaled for `size`: the line is 1.75 px wide on screen\nby default, whatever the size.",
          "default": null,
          "required": false
        },
        {
          "name": "color",
          "type": "string",
          "description": "Stroke color: `currentColor` (the text color) or a semantic color variable, such as\n`var(--vl-color-danger)`.",
          "default": null,
          "required": false
        },
        {
          "name": "aria-hidden",
          "type": "boolean",
          "description": "`true` for a decorative icon (hidden from screen readers).",
          "default": null,
          "required": false
        },
