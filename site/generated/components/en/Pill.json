{
  "name": "Pill",
  "entry": "vellum-ui",
  "usage": "Statuses such as In progress / Archived, markers such as \"Owner\" or \"Connected\", tags",
  "signature": null,
  "props": [
    {
      "name": "tone",
      "type": "'neutral' | 'accent' | 'success' | 'warning' | 'danger' | 'info'",
      "description": "Tone: `neutral`, `accent`, or the semantic states `success` / `warning` / `danger` / `info`.",
      "default": "'neutral'",
      "required": false
    },
    {
      "name": "dot",
      "type": "boolean",
      "description": "Leading dot (indicates a status).",
      "default": null,
      "required": false
    },
    {
      "name": "icon",
      "type": "IconName | IconComponent",
      "description": "Leading icon: a name, or an icon component such as Lucide's `Plus`.",
      "default": null,
      "required": false
    },
    {
      "name": "children",
      "type": "ReactNode",
      "description": "Text of the pill.",
      "default": null,
      "required": false
